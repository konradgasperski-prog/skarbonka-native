<?xml version="1.0" encoding="utf-8"?>
<!--
  Wspólne, zaokrąglone tło dla wszystkich wariantów widgetu salda (mały/średni/duży) - zamiast
  poprzedniego czarnego prostokąta z ostrymi rogami. Promień 24dp odpowiada temu, jak wygląda
  większość nowoczesnych widgetów na Androidzie 12+ / HyperOS (duże zaokrąglenie "karty"), a subtelna
  obwódka odcina widget od tła pulpitu bez potrzeby cienia.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#1c1e20" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="#2a2d30" />
</shape>
